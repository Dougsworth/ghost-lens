# Copy to credentials.env (gitignored) and fill ONE of these in, then:
#   set -a; source tools/webcam-bridge/credentials.env; set +a
#   ./tools/webcam-bridge/run_fast.sh
#
# The first key present wins, in the order listed here. Gemini is the default:
# the lesson planner makes at least two calls per lesson (plan, then review),
# and gemini-flash-latest is the cheapest of the three to run that on. The same
# provider answers the coach tips, so one key configures everything.
#
# With no key at all, GHOST falls back to its bundled lessons and its bundled
# coach lines. Nothing breaks; it just stops being able to teach new skills.
#
# NEVER commit a filled-in copy. credentials.env is in .gitignore for that
# reason, and nothing in the bridge reads a key from anywhere but the
# environment.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Study Together across desktops (optional). Both teammates use the SAME
# Supabase project: Settings > API. Paste the Project URL and the anon public
# key ONLY — the service-role key must never leave the dashboard. Run
# supabase_schema.sql in the SQL editor once first. With these unset, rooms
# stay local to this computer.
SUPABASE_URL=
SUPABASE_ANON_KEY=
