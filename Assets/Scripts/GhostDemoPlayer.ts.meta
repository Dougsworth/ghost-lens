  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">GhostDemoPlayer &ndash; the ghost brush writes a character</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input AssignableType_1 sheet {"hint":"The practice sheet this player draws onto. Supplies the guide/ink/brush layers and the sheet size."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float glyphUnitCm = 15 {"hint":"Centimetres per 1.0 of normalised character height. 15 makes あ about 10.5 cm tall on a 15 cm sheet.", "widget":"slider", "min":5, "max":24, "step":0.5}'
    - '// @input float strokeDurationSec = 1 {"hint":"Seconds the brush takes to draw one stroke at normal speed.", "widget":"slider", "min":0.3, "max":3, "step":0.05}'
    - '// @input float interStrokePauseSec = 0.3 {"hint":"Quiet beat between strokes, in seconds, so each stroke reads as a separate movement.", "widget":"slider", "min":0, "max":1.5, "step":0.05}'
    - '// @input float slowerSpeedMultiplier = 0.5 {"hint":"Speed factor used by the Slower tab. 0.5 = half speed.", "widget":"slider", "min":0.2, "max":1, "step":0.05}'
    - '// @input vec4 inkColor = "{1,0.95,0.86,1}" {"hint":"Wet ink colour. The display is additive, so ink must be a WARM OFF-WHITE LIGHT — black sumi would simply be invisible on glass.", "widget":"color"}'
    - "// @input vec4 guideColor = \"{0.42,0.39,0.33,1}\" {\"hint\":\"Colour the ink settles to after the demo — the guide the user traces. 'Pale grey' means a DIMMED warm white, still emitted light.\", \"widget\":\"color\"}"
    - '// @input float inkWidthCm = 0.55 {"hint":"Brush stroke thickness at its fullest, in cm. Ends taper automatically.", "widget":"slider", "min":0.15, "max":1.5, "step":0.05}'
    - '// @input float fadeSeconds = 0.5 {"hint":"Seconds for the finished ink to fade down into the pale guide outline.", "widget":"slider", "min":0.1, "max":2, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
