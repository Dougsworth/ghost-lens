  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">GhostSheetUI &ndash; stroke counter and the bookmark tabs</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input vec4 markerColor = "{1,0.86,0.55,1}" {"hint":"Colour of the turn markers: the numbered start dot, the direction arrow and the faint end dot. Warm amber so they read as guidance rather than as ink.", "widget":"color"}'
    - "// @input vec4 tabPaperColor = \"{0.26,0.23,0.17,1}\" {\"hint\":\"Bookmark tab paper colour. Matches GhostSheet's paperColor by default so the tabs read as the same sheet of washi, not as separate panels.\", \"widget\":\"color\"}"
    - '// @input vec4 tabHighlightColor = "{0.46,0.41,0.31,1}" {"hint":"Tab colour when the user aims at it — the same paper, lit up. Still washi, never a highlight box.", "widget":"color"}'
    - '// @input vec4 typeColor = "{0.96,0.93,0.86,1}" {"hint":"Colour of the tab labels and the stroke counter. Near-white emitted light: on the additive display the faint washi tab gives the type no dark ground to sit on, so the letters have to carry their own brightness to read at 45 cm.", "widget":"color"}'
    - '// @input vec4 progressDoneColor = "{1.0,0.95,0.86,1}" {"hint":"A progress dot for a character already finished.", "widget":"color"}'
    - '// @input vec4 progressCurrentColor = "{0.72,0.68,0.60,1}" {"hint":"The dot for the character being practised now.", "widget":"color"}'
    - "// @input vec4 progressDimColor = \"{0.30,0.28,0.24,1}\" {\"hint\":\"A dot for a character not reached yet. Dim, never dark: on the additive display an 'empty' dot can only be dim.\", \"widget\":\"color\"}"
    - '// @input float progressDotRadiusCm = 0.2 {"hint":"Radius of each progress dot, in cm.", "widget":"slider", "min":0.08, "max":0.6, "step":0.02}'
    - '// @input float tabWidthCm = 3 {"hint":"Width of each bookmark tab, in cm.", "widget":"slider", "min":2, "max":8, "step":0.1}'
    - '// @input float tabHeightCm = 3.2 {"hint":"Height of each bookmark tab, in cm. The brief asks for at least 3 cm so they stay forgiving pinch targets.", "widget":"slider", "min":2, "max":6, "step":0.1}'
    - '// @input float tabGapCm = 0.6 {"hint":"Vertical gap between stacked tabs, in cm.", "widget":"slider", "min":0, "max":2, "step":0.1}'
    - '// @input float tabOffsetXCm = 8.4 {"hint":"How far right of the sheet centre the tab stack sits, in cm. 8.4 tucks each tab behind the sheet edge so it sticks out like a real bookmark, and keeps the stack inside the visible frame.", "widget":"slider", "min":6, "max":16, "step":0.1}'
    - "// @input vec2 counterOffsetCm = \"{-6.0,6.3}\" {\"hint\":\"Stroke-counter position relative to the sheet centre, in cm. Default is the sheet's top-left corner.\"}"
    - '// @ui {"widget":"group_end"}'
