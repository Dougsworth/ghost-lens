  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">GhostTurnController &ndash; the user traces the guide</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - "// @input AssignableType_1 sheet {\"hint\":\"The practice sheet. User ink is drawn into its inkRoot, in front of the ghost's guide.\"}"
    - '// @input AssignableType_2 pinchInput {"hint":"Pinch source: SIK hand or mouse, plus the webcam bridge when connected."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - "// @input vec4 wetInkColor = \"{1,0.97,0.90,1}\" {\"hint\":\"The user's wet ink while dragging. Additive display: a bright warm off-white, brighter than the guide underneath it.\", \"widget\":\"color\"}"
    - "// @input vec4 driedInkColor = \"{0.92,0.86,0.74,1}\" {\"hint\":\"Colour the user's ink dries to once a stroke is accepted. Stays on the sheet until the page turns.\", \"widget\":\"color\"}"
    - '// @input vec4 pulseColor = "{1,0.86,0.55,1}" {"hint":"Colour of the pulsing marker that shows which part of the stroke to fix.", "widget":"color"}'
    - '// @input vec4 onLineColor = "{0.46,1,0.60,1}" {"hint":"Live ink where the stroke is ON the guide. Additive display: an emitted green, bright enough to read against the warm paper.", "widget":"color"}'
    - '// @input vec4 closeColor = "{1,0.80,0.36,1}" {"hint":"Live ink where the stroke is CLOSE. This still passes — it is a nudge, not a failure.", "widget":"color"}'
    - '// @input vec4 offColor = "{1,0.46,0.38,1}" {"hint":"Live ink where the stroke is OFF. A warm red-orange rather than a signal red: the brief rules out a harsh error, so this has to read as ink that drifted, not as an alarm.", "widget":"color"}'
    - '// @input float onLineCm = 0.9 {"hint":"Distance from the guide, in cm, within which the ink reads as ON the line.", "widget":"slider", "min":0.2, "max":3, "step":0.1}'
    - '// @input float closeCm = 2.2 {"hint":"And within which it reads as CLOSE. Past this it reads as off. Both are display thresholds only — whether the stroke actually passes is still the mean test below.", "widget":"slider", "min":0.5, "max":5, "step":0.1}'
    - '// @input float feedbackBands = 6 {"hint":"How many coloured bands one stroke is split into. More bands localise a mistake more precisely; fewer read more calmly.", "widget":"slider", "min":2, "max":10, "step":1}'
    - '// @input float toleranceCm = 2.4 {"hint":"How far the drag may stray from the guide, averaged over the stroke, in cm. Bigger is more forgiving. Tune this by hand in the preview.", "widget":"slider", "min":0.3, "max":5, "step":0.1}'
    - "// @input float minLengthRatio = 0.3 {\"hint\":\"The drag must be at least this fraction of the guide stroke's length, so a dab at the start point cannot pass.\", \"widget\":\"slider\", \"min\":0.1, \"max\":1, \"step\":0.05}"
    - '// @input float maxLengthRatio = 3 {"hint":"And at most this multiple of it, so scribbling cannot pass.", "widget":"slider", "min":1, "max":5, "step":0.1}'
    - "// @input float startToleranceCm = 3 {\"hint\":\"How far from the stroke's start point you may begin the drag, in cm, before that offset counts against the shape score. Forgives WHERE you start, not what you draw.\", \"widget\":\"slider\", \"min\":0, \"max\":6, \"step\":0.1}"
    - '// @input float minDragSec = 0.25 {"hint":"A pinch shorter than this many seconds is ignored completely - not accepted, and NOT counted as a miss. Stops an accidental tap from burning one of the three tries before the ghost re-demonstrates.", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float armDistanceCm = 0.6 {"hint":"How far your hand must actually travel, in cm, before any ink appears. A pinch alone arms the stroke; it does not paint. Stops ink being laid while you are still getting into position, and makes a stray pinch harmless.", "widget":"slider", "min":0, "max":3, "step":0.1}'
    - '// @input float missesBeforeDemo = 3 {"hint":"Misses on the same stroke before the ghost quietly demonstrates that one stroke again.", "widget":"slider", "min":1, "max":6, "step":1}'
    - "// @input float inkWidthCm = 0.55 {\"hint\":\"Thickness of the user's brush stroke, in cm.\", \"widget\":\"slider\", \"min\":0.15, \"max\":1.5, \"step\":0.05}"
    - '// @input float inputSmoothing = 0.5 {"hint":"How much the incoming pinch path is smoothed before it becomes ink. 0 = raw (every tremor shows as a lump), higher = smoother but the ink trails the finger slightly.", "widget":"slider", "min":0, "max":0.9, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
