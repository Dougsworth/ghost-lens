  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">GhostFretboard &ndash; 6 strings, 5 frets, paper and ink</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input vec4 inkColor = "{1.00,0.95,0.86,1}" {"hint":"Ink: the nut, the string lines and the finger dots. The same warm off-white the kana brush writes with.", "widget":"color"}'
    - '// @input vec4 paperColor = "{0.26,0.23,0.17,1}" {"hint":"Paper: the board itself. Additive display, so this is a faint translucent cream and never dark.", "widget":"color"}'
    - '// @input vec4 guideColor = "{0.42,0.39,0.33,1}" {"hint":"Dimmed ink: the fret hairlines and a dot the user has not reached yet.", "widget":"color"}'
    - '// @input float lengthCm = 30 {"hint":"Nut to fifth fret, in cm. The brief asks for about 30; this runs up the view and away from the user, not across it.", "widget":"slider", "min":18, "max":40, "step":0.5}'
    - '// @input float stringSpanCm = 7.5 {"hint":"Low E to high E across the board, in cm. This is the only thing spending the scarce 21.5 cm of view width.", "widget":"slider", "min":4, "max":12, "step":0.1}'
    - '// @input float tiltDeg = 62 {"hint":"How far the board is pitched back from upright, in degrees. 0 faces the user flat on; 90 lies flat on a table. Higher values foreshorten the board into less apparent height, which is what buys the room for a 30 cm neck.", "widget":"slider", "min":20, "max":75, "step":1}'
    - "// @input vec3 centreCm {\"hint\":\"Where the board's centre sits relative to this object, in cm. Chest height means below the eye line, so y is small and positive only because the pitch-back lifts the far end.\"}"
    - '// @input float dotRadiusCm = 1.05 {"hint":"Radius of a finger dot, in cm. The pinch target around it is wider still.", "widget":"slider", "min":0.5, "max":2, "step":0.05}'
    - '// @input vec4 stampColor = "{0.92,0.26,0.17,1}" {"hint":"The hanko stamp that lands when a chord is played. Additive display: this has to be an emitted vermilion, because a dark red would simply not appear.", "widget":"color"}'
    - '// @ui {"widget":"group_end"}'
