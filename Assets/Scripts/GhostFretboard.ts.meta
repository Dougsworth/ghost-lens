  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">GhostFretboard &ndash; the neck, as a player sees it</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input vec4 inkColor = "{1.00,0.95,0.86,1}" {"hint":"Ink: the nut and the string lines. The same warm off-white the kana brush writes with.", "widget":"color"}'
    - '// @input vec4 paperColor = "{0.26,0.23,0.17,1}" {"hint":"Paper: the neck itself. Additive display, so this is a faint translucent cream and never dark.", "widget":"color"}'
    - '// @input vec4 guideColor = "{0.62,0.58,0.50,1}" {"hint":"Dimmed ink: fret hairlines, string names and fret numbers. Bright enough to read on glass, quiet enough to stay behind the finger circles.", "widget":"color"}'
    - '// @input float fretLengthCm = 7.8 {"hint":"Nut to fifth fret, in cm. This runs ACROSS the view, which is the scarce 21.5 cm axis, so it is much shorter than a real neck and the board sits further back to compensate.", "widget":"slider", "min":5, "max":16, "step":0.1}'
    - '// @input float stringGapCm = 1.45 {"hint":"Distance between neighbouring strings, in cm. Height is the plentiful axis, so this is generous: it is what gives the finger circles room to read as separate.", "widget":"slider", "min":0.8, "max":2.2, "step":0.05}'
    - '// @input float tiltDeg = 14 {"hint":"How far the neck is pitched back from facing you, in degrees. Small on purpose: enough to sit in your space, not so much that the far frets foreshorten into slivers.", "widget":"slider", "min":0, "max":45, "step":1}'
    - "// @input vec3 centreCm {\"hint\":\"Where the neck's centre sits relative to this object, in cm. Negative z pushes it further away, which is what buys the width for a horizontal neck.\"}"
    - '// @input float dotRadiusCm = 0.58 {"hint":"Radius of a finger circle, in cm. The pinch target around it is wider still.", "widget":"slider", "min":0.3, "max":1.2, "step":0.05}'
    - '// @input vec4 stampColor = "{0.92,0.26,0.17,1}" {"hint":"The hanko stamp that lands when a chord is played. Additive display: an emitted vermilion, because a dark red would simply not appear.", "widget":"color"}'
    - '// @ui {"widget":"group_end"}'
