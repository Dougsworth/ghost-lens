  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">GhostSheet &ndash; the 15 cm washi practice sheet</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - "// @input float sheetSizeCm = 15 {\"hint\":\"Side length of the square practice sheet, in cm. The brief's default is 15 cm at 45 cm from the user.\", \"widget\":\"slider\", \"min\":8, \"max\":24, \"step\":0.5}"
    - '// @input vec4 paperColor = "{0.26,0.23,0.17,1}" {"hint":"Washi paper colour. The display is additive, so this is emitted light: keep it a FAINT warm cream, never dark and never bright white.", "widget":"color"}'
    - '// @input vec4 gridColor = "{0.40,0.37,0.30,1}" {"hint":"Practice-grid line colour — a touch brighter than the paper so the four squares read without competing with the ink.", "widget":"color"}'
    - "// @input float edgeJitterCm = 0.12 {\"hint\":\"How far the paper's edge wanders in and out, in cm. Gives the sheet a torn, hand-made edge instead of a panel edge.\", \"widget\":\"slider\", \"min\":0, \"max\":0.5, \"step\":0.01}"
    - '// @input float unrollSeconds = 0.65 {"hint":"Seconds for the sheet to unroll down from its top edge when a notebook opens.", "widget":"slider", "min":0.1, "max":2, "step":0.05}'
    - '// @input vec4 stampColor = "{1,0.27,0.14,1}" {"hint":"Colour of the hanko stamp that lands on finished work. Additive display: an emitted vermilion, because a dark red would not show on glass at all.", "widget":"color"}'
    - '// @ui {"widget":"group_end"}'
