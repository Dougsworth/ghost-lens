    - '// @input float reachGain = 2 {"hint":"How much of the webcam frame your hand needs to cover. 1 = the whole frame. 2 = only the middle half of the frame, so small moves reach every edge of the view and your hand never has to leave the camera.", "widget":"slider", "min":1, "max":3, "step":0.1}'
    - '// @input bool showMarker = true {"hint":"Draw a debug dot on screen where the bridge thinks your index fingertip is. A cyan dot sits in the middle for the first 4 seconds (proves drawing works), then a magenta dot follows your finger and turns white while pinching. It is attached to the camera, so it shows on every screen, not just the practice sheet."}'
    - '// @input SceneObject surface {"hint":"The practice sheet. The webcam frame is mapped onto THIS surface, so the middle of the camera view is the middle of the sheet and a hand sweep crosses the paper. Leave empty to fall back to a plane in front of the camera."}'
    - '// @input float surfaceWidthCm = 15 {"hint":"Width of the mapped area on the surface, in cm. Match the sheet (15 cm)."}'
    - '// @input float surfaceHeightCm = 15 {"hint":"Height of the mapped area on the surface, in cm. Match the sheet (15 cm)."}'
    - '// @input bool singleHandOnly = true {"hint":"Use only the hand nearest the centre of the camera view, so a second person in frame cannot take over the brush."}'
    - "// @input bool ownPinchDecision = true {\"hint\":\"Decide the pinch HERE from pinchDist, instead of trusting the tracker page's own pinch flag. The page latches that flag per hand side, and MediaPipe's handedness label is unreliable on a mirrored image, so with two hands in frame the flag can belong to the other hand.\"}"
    - '// @input float pinchOnRatio = 0.3 {"hint":"Pinch STARTS below this thumb-to-index distance (as a fraction of hand size, so it is the same near or far).", "widget":"slider", "min":0.1, "max":0.9, "step":0.01}'
    - '// @input float pinchOffRatio = 0.55 {"hint":"Pinch ENDS above this. The gap between the two stops the pinch flickering on a borderline hold.", "widget":"slider", "min":0.1, "max":1.2, "step":0.01}'
