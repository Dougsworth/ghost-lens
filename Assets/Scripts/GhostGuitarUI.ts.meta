  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">GhostGuitarUI &ndash; one instruction, the chord name, and the tabs</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - "// @input vec4 tabPaperColor = \"{0.30,0.27,0.20,1}\" {\"hint\":\"Tab paper colour — the washi the other packs' bookmarks use, lifted slightly so a tab reads as a surface on glass.\", \"widget\":\"color\"}"
    - '// @input vec4 tabHighlightColor = "{0.52,0.47,0.36,1}" {"hint":"Tab colour when the user aims at it.", "widget":"color"}'
    - '// @input vec4 typeColor = "{0.96,0.93,0.86,1}" {"hint":"Colour of the instruction, the chord name and the tab labels. Near-white on purpose: the kana pack found dimmer type unreadable on an additive display.", "widget":"color"}'
    - '// @input vec4 dimTypeColor = "{0.62,0.58,0.50,1}" {"hint":"Colour of the quieter type — the counter and the legend — which should read without competing with the instruction.", "widget":"color"}'
    - '// @input float stepHeightCm = 9.3 {"hint":"Height of the single instruction line above centre, in cm. Content past about 11 cm falls outside the SPECS frame at 45 cm (measured by the kana pack, not assumed).", "widget":"slider", "min":6, "max":10.2, "step":0.1}'
    - '// @input float nameHeightCm = 6.2 {"hint":"Height of the chord name, in cm. It sits between the instruction and the top of the neck.", "widget":"slider", "min":4, "max":9, "step":0.1}'
    - '// @input float legendHeightCm = -6.6 {"hint":"Height of the o / x legend, in cm. Negative: below the neck and its fret numbers.", "widget":"slider", "min":-9, "max":-4, "step":0.1}'
    - '// @input float tabHeightCm = -9.4 {"hint":"Height of the tab row, in cm. The tabs run across the bottom rather than down the right, because a horizontal neck already spends the width.", "widget":"slider", "min":-10.6, "max":-7, "step":0.1}'
    - '// @ui {"widget":"group_end"}'
