  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">GhostBridgeCursor &ndash; webcam fingertip dot</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject surface {"hint":"The practice sheet. The dot is parented here and positioned in its local centimetres."}'
    - "// @input AssignableType_1 pinchInput {\"hint\":\"Optional. In the bridge's relative mode the brush is NOT under your hand, so while pinching the cursor follows the brush instead. Leave empty to always show the raw fingertip.\"}"
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Appearance</span>"}'
    - '// @ui {"widget":"group_start", "label":"Appearance"}'
    - '// @input float radiusCm = 0.45 {"hint":"Dot radius in cm. Big enough to find, small enough not to hide the stroke you are tracing.", "widget":"slider", "min":0.1, "max":1.5, "step":0.05}'
    - '// @input vec4 idleColor = {0.55,0.52,0.45,1} {"hint":"Resting colour while the fingertip is tracked but not pinching. Additive: this is emitted light.", "widget":"color"}'
    - "// @input vec4 pinchColor = {1,0.95,0.86,1} {\"hint\":\"Colour while pinching. Brighter than the resting colour, so 'painting' is obvious.\", \"widget\":\"color\"}"
    - "// @input vec4 pressColor = {0.55,0.95,1,1} {\"hint\":\"Flash colour when a pinch presses a button. Distinct from the pinch colour so 'pressed' cannot be mistaken for 'pinching'.\", \"widget\":\"color\"}"
    - '// @input float liftCm = 0.16 {"hint":"How far in front of the sheet the dot floats, in cm. Keeps it above the paper, grid and ink."}'
    - '// @ui {"widget":"group_end"}'
