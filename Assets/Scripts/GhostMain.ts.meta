  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">GhostMain &ndash; shelf, lesson, your turn, Ask GHOST</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject shelfRoot {"hint":"Group root holding the notebook shelf."}'
    - '// @input SceneObject lessonRoot {"hint":"Group root holding the practice sheet and its bookmark tabs."}'
    - '// @input SceneObject askRoot {"hint":"Group root holding the Ask GHOST word picker."}'
    - '// @input AssignableType_1 shelfUI {"hint":"The notebook shelf UI module."}'
    - "// @input AssignableType_2 sheetUI {\"hint\":\"The sheet's stroke counter, caption and bookmark tabs.\"}"
    - '// @input AssignableType_3 askUI {"hint":"The Ask GHOST word picker."}'
    - '// @input AssignableType_4 sheet {"hint":"The washi practice sheet."}'
    - '// @input AssignableType_5 demo {"hint":"The ghost brush that demonstrates a character."}'
    - "// @input AssignableType_6 turn {\"hint\":\"The user's turn: pinch, drag, check, dry.\"}"
    - '// @input AssignableType_7 pinchInput {"hint":"Pinch source shared by the turn controller."}'
    - "// @input SceneObject aslRoot {\"hint\":\"Group root holding the ASL pack's ghost hands and tabs.\"}"
    - "// @input AssignableType_8 aslUI {\"hint\":\"The ASL lesson's sign name, hint and Got it tab.\"}"
    - '// @input AssignableType_9 asl {"hint":"The ghost hands that demonstrate each ASL sign."}'
    - "// @input SceneObject guitarRoot {\"hint\":\"Group root holding the guitar pack's fretboard and tabs.\"}"
    - "// @input AssignableType_10 guitarUI {\"hint\":\"The guitar lesson's chord name, progress and tabs.\"}"
    - '// @input AssignableType_11 guitar {"hint":"The fretboard lesson: the ghost places the chord, then the user does."}'
    - '// @input SceneObject frontRoot {"hint":"Group root holding the front door sheet."}'
    - '// @input AssignableType_12 frontUI {"hint":"The front door: what do you want to learn?"}'
    - '// @input AssignableType_13 lessonSource {"hint":"Plans a lesson, or falls back to a bundled one. Never fails."}'
    - '// @input AssignableType_14 coach {"hint":"One short line after each attempt. Never blocks the lesson."}'
    - '// @input AssignableType_15 speech {"hint":"Say a skill out loud. In the preview the tracker page listens; the typed suggestions are the fallback."}'
    - '// @input AssignableType_16 audio {"hint":"Brush, paper, stamp and spoken-character sounds."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - "// @input string lessonSequence = \"いうえあお\" {\"hint\":\"Characters taught by the Japanese pack, in order. SIMPLEST FIRST: い う え are two strokes, あ お are three. Starting on the easiest shape and adding a stroke later is what lets the guide outline be withdrawn without the lesson falling over. The engine can read any of KanaStrokes' 168 kana.\"}"
    - '// @input bool reanchorOnOpen = true {"hint":"Drop the shelf and the sheet in front of wherever the user is standing when they open, instead of at a fixed spot in the room. Turn off to pin GHOST to the world origin."}'
    - "// @input float anchorDistanceCm = 45 {\"hint\":\"How far in front of the user GHOST appears, in cm. The brief's writing distance is 45.\", \"widget\":\"slider\", \"min\":25, \"max\":90, \"step\":1}"
    - '// @input float cleanRunsBeforeFade = 1 {"hint":"Characters written with no missed strokes before the guide outline starts to fade. Set high to keep the full outline forever.", "widget":"slider", "min":1, "max":6, "step":1}'
    - '// @input float stampHoldSec = 1.1 {"hint":"Seconds the finished sheet rests with its stamp before the page turns.", "widget":"slider", "min":0.2, "max":3, "step":0.1}'
    - '// @input bool debugColliders {"hint":"Wireframe every collider and body in the scene, so pinch hit-zones can be checked. Takes effect on preview restart."}'
    - '// @ui {"widget":"group_end"}'
